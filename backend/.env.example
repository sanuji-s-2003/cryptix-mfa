# Copy to backend/.env and fill in. Never commit .env: it holds the keys (A5).

# Development: a local SQLite file, no setup needed.
DATABASE_URL=sqlite:///./cryptix-dev.db
# Integration and demo: PostgreSQL, as in the design (§3.1). Start it with
# `docker compose up -d` from the repo root, then use this line instead:
# DATABASE_URL=postgresql+psycopg://cryptix:cryptix@localhost:5432/cryptix

# 32-byte keys, base64. Generate each one with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_KEY=
HMAC_KEY=

RP_ID=localhost
RP_NAME=Cryptix
ORIGIN=http://localhost:8000

# true for the demo (SR-1). Browsers treat http://localhost as secure, so false is fine for development.
FORCE_HTTPS=false

# console = emails are printed to the server log instead of being sent
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
